# CacheMind Environment Configuration
PROJECT_NAME="CacheMind"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Groq Cloud Inference (Optional for ultra-fast 500+ tokens/s)
GROQ_API_KEY="your_groq_api_key_here"

# Embedding Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Caching Configuration
REDIS_URL="redis://localhost:6379/0"
EXACT_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
SEMANTIC_CACHE_MAX_ENTRIES=10000
RETRIEVAL_CACHE_TTL_SECONDS=43200
PREFIX_CACHE_ENABLED=true

# Cache Admission Policy
ADMISSION_MIN_FREQUENCY=1
ADMISSION_MIN_GENERATION_COST_MS=100.0

# Local LLM Inference (llama.cpp)
LLAMA_CPP_BASE_URL="http://localhost:8080"
USE_MOCK_LLM_IF_UNAVAILABLE=true

# Model Routing Defaults
DEFAULT_SMALL_MODEL="qwen2.5:0.5b"
DEFAULT_MEDIUM_MODEL="qwen2.5:3b"
DEFAULT_LARGE_MODEL="qwen2.5:7b"
